{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sink",
  "main": ".output/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
    "html_handling": "drop-trailing-slash"
  },
  "compatibility_date": "2025-05-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "upload_source_maps": true,
  "observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  // Values marked with DEPLOY_* below are placeholders for local/dev.
  // CLI deploy (pnpm deploy:worker / deploy:config) rewrites them into gitignored wrangler.deploy.jsonc.
  // Prefer setting DEPLOY_* in .env or Workers Builds / Pages variables — do not hardcode production IDs here.
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "sink" // Override with DEPLOY_ANALYTICS_DATASET (default: sink). Keep in sync with NUXT_DATASET at runtime.
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "preview_id": "fe6ef1cdecaa40bd9fb83e9012c8f8c8", // Override with DEPLOY_KV_PREVIEW_NAMESPACE_ID (falls back to DEPLOY_KV_NAMESPACE_ID)
      "id": "fe6ef1cdecaa40bd9fb83e9012c8f8c8" // Override with DEPLOY_KV_NAMESPACE_ID
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sink", // Override with DEPLOY_D1_DATABASE_NAME (default: sink)
      "database_id": "a47ccfdd-5de4-4527-b326-b1c27e0e2223", // Override with DEPLOY_D1_DATABASE_ID (required for CLI deploy)
      "migrations_dir": "drizzle"
    }
  ],
  "triggers": {
    "crons": ["0 0 * * *"] // Run backup task daily at 00:00 UTC
  }
}
